class Solution {
public:
    int maximalSquare(vector<vector<char>>& matrix) {
        int m = matrix.size(), n = matrix[0].size();
        vector<int> dp(n+1,0);
        int prev=0, ans=0;
        for(int i=1;i<=m;++i){
            for(int j=1;j<=n;++j){
                int tmp = dp[j];
                if(matrix[i-1][j-1]=='1'){
                    dp[j] = 1 + min({dp[j], dp[j-1], prev});
                    ans = max(ans, dp[j]);
                } else dp[j]=0;
                prev = tmp;
            }
        }
        return ans*ans;
    }
};
