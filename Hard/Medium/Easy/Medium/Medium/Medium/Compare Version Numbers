class Solution {
public:
    int compareVersion(string v1, string v2) {
        int i=0,j=0,n=v1.size(),m=v2.size();
        while(i<n || j<m){
            long x=0,y=0;
            while(i<n && v1[i]!='.') x = x*10 + (v1[i++]-'0');
            while(j<m && v2[j]!='.') y = y*10 + (v2[j++]-'0');
            if(x<y) return -1;
            if(x>y) return 1;
            i++; j++; // skip dot
        }
        return 0;
    }
};
