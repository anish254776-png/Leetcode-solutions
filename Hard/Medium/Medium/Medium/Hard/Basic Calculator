class Solution {
public:
    int calculate(string s) {
        long long res = 0, cur = 0;
        int sign = 1;
        stack<pair<long long,int>> st; // res, sign
        for(int i=0;i<s.size();++i){
            char c = s[i];
            if(isdigit(c)){
                cur = cur*10 + (c-'0');
            } else if(c=='+'||c=='-'){
                res += sign*cur;
                cur=0;
                sign = (c=='+'?1:-1);
            } else if(c=='('){
                st.emplace(res, sign);
                res=0; sign=1;
            } else if(c==')'){
                res += sign*cur;
                cur=0;
                auto [prevRes, prevSign] = st.top(); st.pop();
                res = prevRes + prevSign*res;
            }
        }
        res += sign*cur;
        return (int)res;
    }
};
