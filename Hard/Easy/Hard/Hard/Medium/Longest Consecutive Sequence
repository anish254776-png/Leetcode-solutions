class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        unordered_set<int> s(nums.begin(), nums.end());
        int longest = 0;

        for (int num : s) {
            // agar num-1 exist karta hai toh ye start nahi hai
            if (s.count(num - 1)) continue;

            int cur = num;
            int len = 1;
            while (s.count(cur + 1)) {
                cur++;
                len++;
            }
            longest = max(longest, len);
        }
        return longest;
    }
};
