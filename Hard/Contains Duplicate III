class Solution {
public:
    bool containsNearbyAlmostDuplicate(vector<int>& nums, int indexDiff, int valueDiff) {
        if(valueDiff < 0) return false;
        unordered_map<long long, long long> bucket;
        long long w = (long long)valueDiff + 1;
        auto getId = [&](long long x){
            if(x >= 0) return x / w;
            return (x + 1) / w - 1;
        };
        for(int i=0;i<(int)nums.size();++i){
            long long id = getId(nums[i]);
            if(bucket.count(id)) return true;
            if(bucket.count(id-1) && llabs(nums[i] - bucket[id-1]) <= valueDiff) return true;
            if(bucket.count(id+1) && llabs(nums[i] - bucket[id+1]) <= valueDiff) return true;
            bucket[id] = nums[i];
            if(i >= indexDiff){
                long long oldId = getId(nums[i-indexDiff]);
                bucket.erase(oldId);
            }
        }
        return false;
    }
};
