class Solution {
public:
    bool isIsomorphic(string s, string t) {
        int m1[256], m2[256];
        memset(m1, -1, sizeof(m1));
        memset(m2, -1, sizeof(m2));
        for (int i = 0; i < (int)s.size(); ++i) {
            unsigned char a = s[i], b = t[i];
            if (m1[a] == -1 && m2[b] == -1) {
                m1[a] = b;
                m2[b] = a;
            } else {
                if (m1[a]!= b || m2[b]!= a) return false;
            }
        }
        return true;
    }
};
