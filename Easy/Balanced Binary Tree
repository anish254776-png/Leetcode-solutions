class Solution {
public:
    bool isBalanced(TreeNode* root) {
        return check(root) != -1;
    }

    // ye function height return karega, agar unbalanced hua toh -1
    int check(TreeNode* root) {
        if (!root) return 0;

        int left = check(root->left);
        if (left == -1) return -1; // left hi unbalanced

        int right = check(root->right);
        if (right == -1) return -1; // right hi unbalanced

        if (abs(left - right) > 1) return -1; // current node unbalanced

        return max(left, right) + 1; // height return karo
    }
};
