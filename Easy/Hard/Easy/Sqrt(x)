class Solution {
public:
    int mySqrt(int x) {
        if (x < 2) return x;
        long long l = 1, r = x / 2, ans = 0;
        while (l <= r) {
            long long m = l + (r - l) / 2;
            long long sq = m * m;
            if (sq == x) return (int)m;
            if (sq < x) {
                ans = m;
                l = m + 1;
            } else {
                r = m - 1;
            }
        }
        return (int)ans;
    }
};
