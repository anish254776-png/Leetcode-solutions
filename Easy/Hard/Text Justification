class Solution {
public:
    vector<string> fullJustify(vector<string>& words, int maxWidth) {
        vector<string> ans;
        int n = words.size();
        int i = 0;

        while (i < n) {
            int j = i;
            int len = 0;
            // pack as many words as possible
            while (j < n && len + (int)words[j].size() + (j - i) <= maxWidth) {
                len += words[j].size();
                ++j;
            }

            int numWords = j - i;
            int totalSpaces = maxWidth - len;
            string line;

            if (j == n || numWords == 1) { // last line or single word -> left justify
                for (int k = i; k < j; ++k) {
                    if (k > i) line += ' ';
                    line += words[k];
                }
                line += string(maxWidth - line.size(), ' ');
            } else {
                int spacesPerGap = totalSpaces / (numWords - 1);
                int extra = totalSpaces % (numWords - 1); // left gaps get +1

                for (int k = i; k < j; ++k) {
                    line += words[k];
                    if (k < j - 1) {
                        int gaps = spacesPerGap + (k - i < extra? 1 : 0);
                        line += string(gaps, ' ');
                    }
                }
            }
            ans.push_back(line);
            i = j;
        }
        return ans;
    }
};
