class Solution {
public:
    int total = 0;

    void solve(int row, int n, int cols, int diag1, int diag2) {
        if (row == n) {
            total++;
            return;
        }

        // all available positions
        int available = ((1 << n) - 1) & ~(cols | diag1 | diag2);

        while (available) {
            int pos = available & -available; // get rightmost 1 bit
            available -= pos;

            solve(row + 1, n,
                  cols | pos,
                  (diag1 | pos) << 1,
                  (diag2 | pos) >> 1);
        }
    }

    int totalNQueens(int n) {
        total = 0;
        solve(0, n, 0, 0, 0);
        return total;
    }
};
