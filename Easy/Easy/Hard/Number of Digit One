class Solution {
public:
    int countDigitOne(int n) {
        long long count = 0;
        long long factor = 1;
        long long N = n;
        while (N / factor != 0) {
            long long lower = N - (N / factor) * factor;
            long long cur = (N / factor) % 10;
            long long higher = N / (factor * 10);

            if (cur == 0) {
                count += higher * factor;
            } else if (cur == 1) {
                count += higher * factor + lower + 1;
            } else {
                count += (higher + 1) * factor;
            }
            factor *= 10;
        }
        return (int)count;
    }
};
