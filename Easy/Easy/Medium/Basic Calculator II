class Solution {
public:
    int calculate(string s) {
        long long last = 0, res = 0;
        char op = '+';
        long long cur = 0;
        for(int i=0;i<=s.size();++i){
            char c = i<s.size()? s[i] : '#';
            if(isdigit(c)) cur = cur*10 + (c-'0');
            else if(c==' ' ) continue;
            else{
                if(op=='+'){ res+=last; last=cur; }
                else if(op=='-'){ res+=last; last=-cur; }
                else if(op=='*'){ last*=cur; }
                else if(op=='/'){ last/=cur; }
                op=c;
                cur=0;
            }
        }
        res+=last;
        return (int)res;
    }
};
