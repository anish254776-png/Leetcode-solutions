class Solution {
public:
    vector<string> findRepeatedDnaSequences(string s) {
        if(s.size() < 10) return {};
        unordered_map<string,int> cnt;
        vector<string> res;
        for(int i=0;i+10<=s.size();i++){
            string t = s.substr(i,10);
            if(++cnt[t]==2) res.push_back(t);
        }
        return res;
    }
};
