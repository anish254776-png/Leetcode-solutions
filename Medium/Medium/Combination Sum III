class Solution {
    vector<vector<int>> ans;
    vector<int> cur;
    void dfs(int start, int k, int n){
        if(k==0){
            if(n==0) ans.push_back(cur);
            return;
        }
        for(int i=start;i<=9;++i){
            if(i>n) break;
            cur.push_back(i);
            dfs(i+1, k-1, n-i);
            cur.pop_back();
        }
    }
public:
    vector<vector<int>> combinationSum3(int k, int n) {
        dfs(1,k,n);
        return ans;
    }
};
