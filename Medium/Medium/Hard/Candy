class Solution {
public:
    int candy(vector<int>& ratings) {
        int n = ratings.size();
        vector<int> c(n, 1);

        // left to right
        for (int i = 1; i < n; i++) {
            if (ratings[i] > ratings[i-1]) c[i] = c[i-1] + 1;
        }
        // right to left
        for (int i = n-2; i >= 0; i--) {
            if (ratings[i] > ratings[i+1]) c[i] = max(c[i], c[i+1] + 1);
        }

        int sum = 0;
        for (int x : c) sum += x;
        return sum;
    }
};
