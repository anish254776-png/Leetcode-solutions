class Solution {
public:
    string shortestPalindrome(string s) {
        int n = s.size();
        if (n==0) return "";
        string rev = s;
        reverse(rev.begin(), rev.end());
        string t = s + "#" + rev;
        int m = t.size();
        vector<int> lps(m,0);
        for(int i=1;i<m;++i){
            int j = lps[i-1];
            while(j>0 && t[i]!=t[j]) j=lps[j-1];
            if(t[i]==t[j]) ++j;
            lps[i]=j;
        }
        int add = n - lps.back();
        return rev.substr(0, add) + s;
    }
};
