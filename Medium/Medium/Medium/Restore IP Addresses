class Solution {
public:
    vector<string> restoreIpAddresses(string s) {
        vector<string> ans;
        vector<string> cur;
        dfs(0, s, cur, ans);
        return ans;
    }
    void dfs(int idx, string &s, vector<string> &cur, vector<string> &ans){
        if(cur.size()==4){
            if(idx==s.size()){
                ans.push_back(cur[0]+"."+cur[1]+"."+cur[2]+"."+cur[3]);
            }
            return;
        }
        if(idx>=s.size()) return;
        // 1-3 digits
        for(int len=1; len<=3 && idx+len<=s.size(); ++len){
            string part = s.substr(idx,len);
            if(part.size()>1 && part[0]=='0') break;
            int v = stoi(part);
            if(v>255) break;
            cur.push_back(part);
            dfs(idx+len, s, cur, ans);
            cur.pop_back();
        }
    }
};
