class Solution {
public:
    vector<vector<string>> result;

    vector<vector<string>> solveNQueens(int n) {
        vector<string> board(n, string(n, '.'));
        unordered_set<int> cols, diag1, diag2; // diag1 = r+c, diag2 = r-c
        backtrack(0, n, board, cols, diag1, diag2);
        return result;
    }

    void backtrack(int r, int n, vector<string>& board,
                   unordered_set<int>& cols,
                   unordered_set<int>& diag1,
                   unordered_set<int>& diag2){
        if(r == n){
            result.push_back(board);
            return;
        }

        for(int c = 0; c < n; c++){
            if(cols.count(c) || diag1.count(r+c) || diag2.count(r-c))
                continue;

            // place
            board[r][c] = 'Q';
            cols.insert(c);
            diag1.insert(r+c);
            diag2.insert(r-c);

            backtrack(r+1, n, board, cols, diag1, diag2);

            // remove - backtrack
            board[r][c] = '.';
            cols.erase(c);
            diag1.erase(r+c);
            diag2.erase(r-c);
        }
    }
};
