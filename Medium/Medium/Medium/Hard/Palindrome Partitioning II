class Solution {
public:
    int minCut(string s) {
        int n = s.size();
        vector<vector<bool>> isPal(n, vector<bool>(n, false));
        vector<int> dp(n, 0);

        for (int i = 0; i < n; i++) {
            int minCut = i; // worst case: cut each char
            for (int j = 0; j <= i; j++) {
                if (s[j] == s[i] && (i - j <= 1 || isPal[j+1][i-1])) {
                    isPal[j][i] = true;
                    if (j == 0) minCut = 0;
                    else minCut = min(minCut, dp[j-1] + 1);
                }
            }
            dp[i] = minCut;
        }
        return dp[n-1];
    }
};
