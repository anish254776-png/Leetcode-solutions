class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int n = nums.size();
        if (n <= 2) return n;

        int k = 2; // pehle 2 element to allowed hi hain

        for (int i = 2; i < n; i++) {
            // agar current element k-2 wale se alag hai, to allow karo
            // matlab 2 se zyada duplicate nahi hoga
            if (nums[i]!= nums[k - 2]) {
                nums[k] = nums[i];
                k++;
            }
        }
        return k;
    }
};
